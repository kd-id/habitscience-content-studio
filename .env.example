# ==============================================================================
# Content Automation Studio — Environment Variables
# Salin file ini menjadi ".env" dan isi kredensial yang ingin Anda aktifkan.
# Tanpa API key pun pipeline tetap bisa berjalan penuh via Antigravity Agent
# atau mode lokal + dry-run!
# ==============================================================================

# 1. Gemini API (Opsional — untuk mode CLI mandiri / headless tanpa Antigravity)
GEMINI_API_KEY=

# 2. YouTube Data API v3 (OAuth2 Desktop App Credentials dari Google Cloud Console)
# Simpan file JSON OAuth Anda di config/youtube_client_secret.json
YOUTUBE_CLIENT_SECRETS_FILE=config/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=config/youtube_token.json
# Khusus Cloud (GitHub Actions / Docker): hasil Base64 dari `python -m src.auth_youtube`
YOUTUBE_TOKEN_JSON=

# 8. Khusus Docker Cloud Scheduler 24/7 (`docker compose --profile scheduler up -d`)
SCHEDULE_TZ=Asia/Jakarta
SCHEDULE_TIME_WIB=08:00
SCHEDULE_DAYS=mon,tue,wed,thu,fri,sat,sun
PUBLISH_MODE=draft
RUN_ON_STARTUP=false

# 3. Universal Social Publisher Webhook (Zapier / n8n / Make)
# Menerima payload JSON lengkap berisi link/path video, carousel, caption, & mode (draft/publish)
PUBLISH_WEBHOOK_URL=
PUBLISH_WEBHOOK_SECRET=

# 4. Meta Graph API (Opsional — Direct Instagram / Facebook)
META_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
FB_PAGE_ID=

# 5. LinkedIn API (Opsional — Direct Post / Draft)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

# 6. X / Twitter API (Opsional)
X_BEARER_TOKEN=

# 7. Notifikasi Laporan (Opsional — Discord / Slack / Telegram Webhook)
REPORT_NOTIFICATION_WEBHOOK_URL=
