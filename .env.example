# ==============================================================================
# Content Automation Studio — Environment Variables
# Salin file ini menjadi ".env" dan isi kredensial yang ingin Anda aktifkan.
# Tanpa API key pun pipeline tetap bisa berjalan penuh via Antigravity Agent
# atau mode lokal + dry-run!
# ==============================================================================

# 1. Gemini API (Text + Gemini Studio TTS — gratis di Free Tier!)
GEMINI_API_KEY=

# 1b. Cloudflare Workers AI FLUX.1-schnell (GRATIS 10.000 neurons/hari untuk gambar AI di Cloud!)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# 1c. Pexels & Pixabay Video API (GRATIS — rekaman cinema HD/4K nyata bebas copyright untuk Studio v6!)
# Daftar 30 detik gratis di https://www.pexels.com/api/ dan https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=

# 2. YouTube Data API v3 (OAuth2 Desktop App Credentials dari Google Cloud Console)
# Simpan file JSON OAuth Anda di config/youtube_client_secret.json
YOUTUBE_CLIENT_SECRETS_FILE=config/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=config/youtube_token.json
# Khusus Cloud (GitHub Actions / Docker): hasil Base64 dari `python -m src.auth_youtube`
YOUTUBE_TOKEN_JSON=

# 8. Khusus Docker Cloud Scheduler 24/7 (`docker compose --profile scheduler up -d`)
SCHEDULE_TZ=Asia/Jakarta
SCHEDULE_TIME_WIB=08:00
SCHEDULE_DAYS=mon,tue,wed,thu,fri,sat,sun
PUBLISH_MODE=draft
RUN_ON_STARTUP=false

# 3. Universal Social Publisher Webhook (Zapier / n8n / Make)
# Menerima payload JSON lengkap berisi link/path video, carousel, caption, & mode (draft/publish)
PUBLISH_WEBHOOK_URL=
PUBLISH_WEBHOOK_SECRET=

# 4. Meta Graph API GRATIS (Direct Instagram Reels & Carousel + Facebook Page Reels)
# Gunakan `python -m src.auth_social --discover-meta` untuk menemukan ID otomatis!
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
FB_PAGE_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
FB_PAGE_ID=

# 5. TikTok Content Posting API v2 GRATIS (Direct Binary Upload ke TikTok Inbox Draft!)
# Pasang TIKTOK_REFRESH_TOKEN + CLIENT_KEY + CLIENT_SECRET agar auto-refresh 365 hari di Cloud!
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_DIRECT_POST=0

# 6. LinkedIn REST API GRATIS (Direct Multi-Image Carousel / Post)
# Gunakan `python -m src.auth_social --discover-linkedin` untuk menemukan URN otomatis!
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

# 7. Meta Threads API GRATIS & X (Twitter API v2 Free Tier — OAuth 1.0a)
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# 8. Notifikasi Laporan (Opsional — Discord / Slack / Telegram Webhook)
REPORT_NOTIFICATION_WEBHOOK_URL=
